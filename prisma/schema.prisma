generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model car_brands {
  id                      BigInt                    @id @default(autoincrement())
  name                    String                    @unique(map: "car_brands_name_unique") @db.VarChar(255)
  created_by              BigInt?
  updated_by              BigInt?
  created_at              DateTime?                 @db.Timestamp(0)
  updated_at              DateTime?                 @db.Timestamp(0)
  market_vehicle_listings market_vehicle_listings[]
  vehicle_registry        vehicle_registry[]
}

model car_images {
  id         BigInt    @id @default(autoincrement())
  car_id     BigInt
  image      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cars {
  id                  BigInt           @id @default(autoincrement())
  vehicle_registry_id BigInt
  seller_id           BigInt?
  title               String?          @db.VarChar(255)
  description         String?
  price               Decimal          @db.Decimal(12, 2)
  currency            String           @default("EUR") @db.VarChar(255)
  mileage             Int?
  condition           String           @default("used") @db.VarChar(255)
  is_vat              Boolean          @default(false)
  is_negotiable       Boolean          @default(false)
  is_featured         Boolean          @default(false)
  is_active           Boolean          @default(true)
  status              String           @default("draft") @db.VarChar(255)
  views               Int              @default(0)
  published_at        DateTime?        @db.Timestamp(0)
  expires_at          DateTime?        @db.Timestamp(0)
  created_by          BigInt?
  updated_by          BigInt?
  created_at          DateTime?        @db.Timestamp(0)
  updated_at          DateTime?        @db.Timestamp(0)
  deleted_at          DateTime?        @db.Timestamp(0)
  thumbnail_image     String?          @db.VarChar(255)
  users               users?           @relation(fields: [seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cars_seller_id_foreign")
  vehicle_registry    vehicle_registry @relation(fields: [vehicle_registry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cars_vehicle_registry_id_foreign")
}

model conversations {
  id              BigInt    @id @default(autoincrement())
  car_id          BigInt?
  buyer_id        BigInt?
  dealer_id       BigInt?
  message         String?   @db.VarChar(255)
  is_read         Boolean   @default(false)
  conversation_id BigInt?
  read_at         DateTime? @db.Timestamp(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  @@index([buyer_id], map: "conversations_buyer_id_index")
  @@index([dealer_id], map: "conversations_dealer_id_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String
  queue      String
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model financing_options {
  id             BigInt    @id @default(autoincrement())
  bank_name      String?   @db.VarChar(255)
  interest_rate  Decimal?  @db.Decimal(5, 2)
  tenure_months  Int?
  processing_fee Decimal?  @db.Decimal(10, 2)
  min_amount     Decimal?  @db.Decimal(12, 2)
  max_amount     Decimal?  @db.Decimal(12, 2)
  is_active      Boolean   @default(true)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int    @db.SmallInt
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model market_vehicle_listings {
  id                BigInt     @id @default(autoincrement())
  brand_id          BigInt
  model             String     @db.VarChar(255)
  variant           String?    @db.VarChar(255)
  trim              String?    @db.VarChar(255)
  manufacture_year  Int?
  model_year        Int?
  fuel_type         String?    @db.VarChar(255)
  transmission      String?    @db.VarChar(255)
  engine_cc         Int?       @db.SmallInt
  engine_liter      Decimal?   @db.Decimal(4, 1)
  power_kw          Int?       @db.SmallInt
  horsepower        Int?       @db.SmallInt
  drivetrain        String?    @db.VarChar(255)
  body_type         String?    @db.VarChar(255)
  doors             Int?       @db.SmallInt
  seats             Int?       @db.SmallInt
  mileage           Int
  price             Decimal    @db.Decimal(12, 2)
  currency          String     @default("EUR") @db.VarChar(3)
  location          String?    @db.VarChar(255)
  listing_date      DateTime?  @db.Date
  source            String?    @db.VarChar(255)
  source_listing_id String?    @db.VarChar(255)
  listing_url       String?
  data_type         String     @default("synthetic") @db.VarChar(255)
  created_at        DateTime?  @db.Timestamp(0)
  updated_at        DateTime?  @db.Timestamp(0)
  car_brands        car_brands @relation(fields: [brand_id], references: [id], onUpdate: NoAction, map: "market_vehicle_listings_brand_id_foreign")

  @@unique([source, source_listing_id], map: "market_listing_source_unique")
  @@index([brand_id, model, manufacture_year, fuel_type, transmission], map: "market_vehicle_comparison_index")
  @@index([body_type], map: "market_vehicle_listings_body_type_index")
  @@index([data_type], map: "market_vehicle_listings_data_type_index")
  @@index([fuel_type], map: "market_vehicle_listings_fuel_type_index")
  @@index([listing_date], map: "market_vehicle_listings_listing_date_index")
  @@index([location], map: "market_vehicle_listings_location_index")
  @@index([mileage], map: "market_vehicle_listings_mileage_index")
  @@index([model], map: "market_vehicle_listings_model_index")
  @@index([transmission], map: "market_vehicle_listings_transmission_index")
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement())
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt
  name           String
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt?
  ip_address    String? @db.VarChar(45)
  user_agent    String?
  payload       String
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model users {
  id                BigInt    @id @default(autoincrement())
  name              String    @db.VarChar(255)
  email             String    @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamp(0)
  password          String    @db.VarChar(255)
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
  is_active         Boolean   @default(true)
  mobile            String?   @unique(map: "users_mobile_unique") @db.VarChar(20)
  is_admin          Boolean   @default(false)
  cars              cars[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vehicle_orders {
  id                           BigInt            @id @default(autoincrement())
  buyer_id                     BigInt?
  car_id                       BigInt?
  financing_option_id          BigInt?
  order_type                   String            @db.VarChar(255)
  payment_type                 String            @db.VarChar(255)
  desired_amount               Decimal?          @db.Decimal(10, 2)
  down_payment                 Decimal?          @db.Decimal(12, 2)
  loan_amount                  Decimal?          @db.Decimal(12, 2)
  reservation_amount           Decimal?          @db.Decimal(12, 2)
  status                       String            @default("pending") @db.VarChar(255)
  created_at                   DateTime?         @db.Timestamp(0)
  updated_at                   DateTime?         @db.Timestamp(0)
  trade_in_vehicle_registry_id BigInt?
  vehicle_registry             vehicle_registry? @relation(fields: [trade_in_vehicle_registry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "vehicle_orders_trade_in_vehicle_registry_id_foreign")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model vehicle_registry {
  id                        BigInt               @id @default(autoincrement())
  registration_number       String               @unique(map: "vehicle_registry_registration_number_unique") @db.VarChar(255)
  vin                       String?              @db.VarChar(50)
  brand_id                  BigInt?
  model                     String?              @db.VarChar(255)
  variant                   String?              @db.VarChar(255)
  trim                      String?              @db.VarChar(255)
  manufacture_year          Int?
  model_year                Int?
  registration_year         Int?
  first_registration_date   DateTime?            @db.Date
  fuel_type                 String?              @db.VarChar(255)
  transmission              String?              @db.VarChar(255)
  engine_cc                 Int?                 @db.SmallInt
  engine_liter              Decimal?             @db.Decimal(4, 1)
  power_kw                  Int?                 @db.SmallInt
  horsepower                Int?                 @db.SmallInt
  drivetrain                String?              @db.VarChar(255)
  body_type                 String?              @db.VarChar(255)
  color                     String?              @db.VarChar(255)
  doors                     Int?                 @db.SmallInt
  seats                     Int?                 @db.SmallInt
  weight                    Int?
  max_weight                Int?
  co2_emission              Int?                 @db.SmallInt
  fuel_consumption_city     Decimal?             @db.Decimal(4, 1)
  fuel_consumption_highway  Decimal?             @db.Decimal(4, 1)
  fuel_consumption_combined Decimal?             @db.Decimal(4, 1)
  emission_class            String?              @db.VarChar(255)
  inspection_date           DateTime?            @db.Date
  next_inspection_due       DateTime?            @db.Date
  is_tax_paid               Boolean?
  provider                  String               @default("manual") @db.VarChar(255)
  source_id                 String?              @db.VarChar(255)
  last_synced_at            DateTime?            @db.Timestamp(0)
  last_lookup_at            DateTime?            @db.Timestamp(0)
  created_at                DateTime?            @db.Timestamp(0)
  updated_at                DateTime?            @db.Timestamp(0)
  deleted_at                DateTime?            @db.Timestamp(0)
  provider_brand_name       String?              @db.VarChar(255)
  engine_code               String?              @db.VarChar(255)
  turbo                     Boolean?
  tow_bar                   Boolean?
  insurance_company         String?              @db.VarChar(255)
  cars                      cars[]
  vehicle_orders            vehicle_orders[]
  car_brands                car_brands?          @relation(fields: [brand_id], references: [id], onUpdate: NoAction, map: "vehicle_registry_brand_id_foreign")
  vehicle_valuations        vehicle_valuations[]

  @@index([body_type], map: "vehicle_registry_body_type_index")
  @@index([fuel_type], map: "vehicle_registry_fuel_type_index")
  @@index([model], map: "vehicle_registry_model_index")
  @@index([transmission], map: "vehicle_registry_transmission_index")
  @@index([vin], map: "vehicle_registry_vin_index")
}

model vehicle_valuations {
  id                  BigInt           @id @default(autoincrement())
  vehicle_registry_id BigInt
  market_value_min    Decimal?         @db.Decimal(12, 2)
  market_value_max    Decimal?         @db.Decimal(12, 2)
  trade_in_value_min  Decimal?         @db.Decimal(12, 2)
  trade_in_value_max  Decimal?         @db.Decimal(12, 2)
  comparable_count    Int              @default(0)
  algorithm_version   String           @default("1.0") @db.VarChar(255)
  currency            String           @default("EUR") @db.VarChar(3)
  calculated_at       DateTime?        @db.Timestamp(0)
  created_at          DateTime?        @db.Timestamp(0)
  updated_at          DateTime?        @db.Timestamp(0)
  vehicle_registry    vehicle_registry @relation(fields: [vehicle_registry_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "vehicle_valuations_vehicle_registry_id_foreign")

  @@index([vehicle_registry_id, calculated_at], map: "vehicle_valuation_history_index")
}
